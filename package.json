{
  "name": "@homeservefinance/eslint-config",
  "version": "0.4.0",
  "description": "Shared ESLint flat configuration for HomeServe Finance frontend applications",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homeservefinance/eslint-config.git"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "npm run lint && node --test test/config.test.js"
  },
  "peerDependencies": {
    "eslint": ">=9.39 <11",
    "typescript": ">=5.7 <7"
  },
  "devDependencies": {
    "eslint": "10.10.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@eslint/js": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.12.0",
    "typescript-eslint": "8.70.0"
  }
}
